# Yuber environment template
# Copy this file to .env.local for local Next.js development or configure these values
# as deployment secrets in Railway, Vercel, Docker, or your preferred runtime.

# Runtime
NODE_ENV=development
VITE_APP_ID=yuber-local
OWNER_OPEN_ID=local-owner

# Database: Turso/libSQL + Drizzle
# Production should use a hosted Turso URL and token.
# Local smoke tests can use a file-backed URL, for example: file:local.db
TURSO_DATABASE_URL=libsql://YOUR_DB.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN

# Authentication
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-secret-in-production

# Provider search
YELP_API_KEY=YOUR_YELP_API_KEY
YELP_CLIENT_ID=YOUR_YELP_CLIENT_ID

# AI triage and dispatch assistance
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GROQ_API_KEY=

# Maps and front-end integrations
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
NEXT_PUBLIC_FRONTEND_FORGE_API_KEY=
NEXT_PUBLIC_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# Optional observability
OPIK_API_KEY=
OPIK_PROJECT_NAME=yuber
